<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FFC567;" stylesheets="@home.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.poo.registrationsystem.controller.CadastroNotasController">
   <children>
      <StackPane prefHeight="150.0" prefWidth="200.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ListView fx:id="idListaAlunos" maxWidth="350.0" prefHeight="299.0" prefWidth="350.0" styleClass="lista-brutalista">
                     <HBox.margin>
                        <Insets right="3.0" />
                     </HBox.margin></ListView>
                  <VBox maxWidth="300.0" prefHeight="299.0" prefWidth="298.0" spacing="5.0" style="-fx-background-color: #6C5CE7;" styleClass="cartao-brutalista" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label styleClass="label-brutalista" text="Nota 1:" />
                              <TextField fx:id="idNota1" styleClass="text-field-brutalista" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label styleClass="label-brutalista" text="Nota 2:" />
                              <TextField fx:id="idNota2" styleClass="text-field-brutalista" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label styleClass="label-brutalista" text="Nota 3:" />
                              <TextField fx:id="idNota3" styleClass="text-field-brutalista" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label fx:id="msgErroLog" alignment="CENTER" prefHeight="18.0" prefWidth="211.0" textAlignment="CENTER" />
                              <Button fx:id="btnSalvarNotas" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#salvarNotas" prefHeight="45.0" prefWidth="115.0" styleClass="botao-destaque" text="Cadastrar">
                                 <VBox.margin>
                                    <Insets left="30.0" top="5.0" />
                                 </VBox.margin>
                              </Button>
                           </children>
                        </VBox>
                     </children>
                     <HBox.margin>
                        <Insets left="12.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
