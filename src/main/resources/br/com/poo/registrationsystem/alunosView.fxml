<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FD5A46;" stylesheets="@home.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.poo.registrationsystem.controller.AlunoController">
